 },
 "92bd9225-63a5-41cb-9451-fd674cd017bd": {
  "mcq_solution_index": 2,
  "answer_text": "$\\frac{\\pi}{6}$",
  "explanation_text": "\n$\\cot2\\theta\\cdot\\cot\\theta=1$ ⇒ $\\cot2\\theta=\\tan\\theta=\\cot\\left(\\frac{\\pi}{2}-\\theta\\right)$\n⇒ $2\\theta=n\\pi+\\frac{\\pi}{2}-\\theta$ ⇒ $3\\theta=n\\pi+\\frac{\\pi}{2}$ ⇒ $\\theta=\\frac{n\\pi}{3}+\\frac{\\pi}{6}$।\n$0<\\theta<\\frac{\\pi}{2}$-এ: $\\theta=\\frac{\\pi}{6}$ (n=0)।\n\nব্যাখ্যা: $\\theta=\\frac{\\pi}{6}$।\n"
 },
 "eb72ff98-86a4-4c1b-a00f-28e10101de31": {
  "mcq_solution_index": 0,
  "answer_text": "$2 n \\pi, \\frac{2}{5} n \\pi, n \\in \\mathbb{Z}$",
  "explanation_text": "\n$\\cos3\\theta=\\cos2\\theta$ ⇒ $3\\theta=2n\\pi\\pm2\\theta$।\n$3\\theta=2n\\pi+2\\theta$ ⇒ $\\theta=2n\\pi$; $3\\theta=2n\\pi-2\\theta$ ⇒ $5\\theta=2n\\pi$ ⇒ $\\theta=\\frac{2n\\pi}{5}$।\n∴ $\\theta=2n\\pi,\\ \\frac{2n\\pi}{5}$।\n\nব্যাখ্যা: $\\theta=2n\\pi,\\ \\frac{2}{5}n\\pi$।\n"
 },
 "f8959517-b784-4a86-8490-ce057bfb1584": {
  "mcq_solution_index": 2,
  "answer_text": "$0, \\frac{\\pi}{2}$",
  "explanation_text": "\n$\\cos\\left(\\frac{\\pi}{2}\\sin\\alpha\\right)=\\sin\\left(\\frac{\\pi}{2}-\\frac{\\pi}{2}\\sin\\alpha\\right)$।\n∴ $\\frac{\\pi}{2}\\cos\\alpha=\\frac{\\pi}{2}-\\frac{\\pi}{2}\\sin\\alpha$ ⇒ $\\cos\\alpha+\\sin\\alpha=1$।\nবর্গে: $1+\\sin2\\alpha=1$ ⇒ $\\sin2\\alpha=0$ ⇒ $\\alpha=0,\\frac{\\pi}{2}$ (যাচাই: উভয়েই সিদ্ধ করে)।\n\nব্যাখ্যা: $\\alpha=0,\\ \\frac{\\pi}{2}$।\n"
 },
 "549398e2-05c0-4637-b062-7087bf6c82c1": {
  "mcq_solution_index": 2,
  "answer_text": "$\\frac{\\pi}{4}$",
  "explanation_text": "\n$\\tan\\theta+\\cot\\theta=2$ ⇒ $\\tan\\theta+\\frac{1}{\\tan\\theta}=2$ ⇒ $t^{2}-2t+1=0$ ⇒ $t=1$ ⇒ $\\theta=\\frac{\\pi}{4}$।\n\nব্যাখ্যা: $\\tan\\theta=1$; $\\frac{\\pi}{4}$।\n"
 },
 "89e6bbb7-c4f6-47c4-a0fc-373c2c1d0cc3": {
  "mcq_solution_index": 2,
  "answer_text": "$2 \\mathrm{n} \\pi+\\frac{\\pi}{3}$",
  "explanation_text": "\n$\\cos\\theta+\\sqrt{3}\\sin\\theta=2\\cos\\left(\\theta-\\frac{\\pi}{3}\\right)=2$ ⇒ $\\cos\\left(\\theta-\\frac{\\pi}{3}\\right)=1$\n⇒ $\\theta-\\frac{\\pi}{3}=2n\\pi$ ⇒ $\\theta=2n\\pi+\\frac{\\pi}{3}$।\n\nব্যাখ্যা: R-রূপান্তর; $2n\\pi+\\frac{\\pi}{3}$।\n"
 },
 "6d36d7ff-76f9-481e-8790-1c50c4d62f87": {
  "mcq_solution_index": 1,
  "answer_text": "$\\frac{7 \\pi}{6}$",
  "explanation_text": "\n$2\\cos^{2}\\theta+\\sin\\theta=1$ ⇒ $2(1-\\sin^{2}\\theta)+\\sin\\theta=1$ ⇒ $2\\sin^{2}\\theta-\\sin\\theta-1=0$\n⇒ $(2\\sin\\theta+1)(\\sin\\theta-1)=0$ ⇒ $\\sin\\theta=1$ বা $\\sin\\theta=-\\frac{1}{2}$।\n$0\\leq\\theta\\leq2\\pi$-এ অপশন যাচাই: $\\frac{7\\pi}{6}$-এ $\\sin=-\\frac{1}{2}$ ✓।\n\nব্যাখ্যা: $\\sin\\frac{7\\pi}{6}=-\\frac{1}{2}$।\n"
 },
 "0ba48668-42a1-4bed-b167-5d51b9c0fbe2": {
  "mcq_solution_index": 0,
  "answer_text": "$\\mathrm{n} \\pi-\\frac{\\pi}{4}, \\mathrm{n} \\in \\mathrm{Z}$",
  "explanation_text": "\n$\\sin x+\\cos x=0$ ⇒ $\\tan x=-1$ ⇒ $x=n\\pi-\\frac{\\pi}{4}$, $n\\in\\mathbb{Z}$।\n\nব্যাখ্যা: $\\tan x=-1$; $n\\pi-\\frac{\\pi}{4}$।\n"
 },
 "ba291de8-22cb-49e1-b120-0f4d2298f1a6": {
  "mcq_solution_index": 3,
  "answer_text": "$\\frac{n \\pi}{7}$",
  "explanation_text": "\n$\\tan3\\theta+\\tan4\\theta=0$ ⇒ $\\tan3\\theta=-\\tan4\\theta=\\tan(-4\\theta)$\n⇒ $3\\theta=n\\pi-4\\theta$ ⇒ $7\\theta=n\\pi$ ⇒ $\\theta=\\frac{n\\pi}{7}$।\n\nব্যাখ্যা: $\\theta=\\frac{n\\pi}{7}$।\n"
 },
 "3b8f0679-b8bc-45ff-ae54-34dc1c0a3fa0": {
  "mcq_solution_index": 2,
  "answer_text": "$(4 n+1) \\frac{\\pi}{4}$",
  "explanation_text": "\n$\\tan x\\tan3x=1$ ⇒ $\\tan3x=\\cot x=\\tan\\left(\\frac{\\pi}{2}-x\\right)$\n⇒ $3x=n\\pi+\\frac{\\pi}{2}-x$ ⇒ $4x=n\\pi+\\frac{\\pi}{2}$ ⇒ $x=\\frac{(4n+1)\\pi}{8}$।\n\nব্যাখ্যা: $x=(4n+1)\\frac{\\pi}{8}$।\n"
 },
 "0e509b37-b0c4-484e-a16b-db5df4d989b7": {
  "mcq_solution_index": 2,
  "answer_text": "$x=n \\pi \\pm \\frac{\\pi}{8} ; \\mathrm{n} \\in \\mathbb{Z}$",
  "explanation_text": "\n$\\sqrt{2}(\\cos^{2}x-\\sin^{2}x)=\\sqrt{2}\\cos2x=1$ ⇒ $\\cos2x=\\frac{1}{\\sqrt{2}}$\n⇒ $2x=2n\\pi\\pm\\frac{\\pi}{4}$ ⇒ $x=n\\pi\\pm\\frac{\\pi}{8}$।\n\nব্যাখ্যা: $x=n\\pi\\pm\\frac{\\pi}{8}$।\n"
 },
 "56f97626-16fc-46e0-bad3-db71b884aff4": {
  "mcq_solution_index": 0,
  "answer_text": "$(8 n \\pm 1) \\frac{\\pi}{8}$",
  "explanation_text": "\n$\\cos2x=\\frac{1}{\\sqrt{2}}$ ⇒ $2x=2n\\pi\\pm\\frac{\\pi}{4}$ ⇒ $x=n\\pi\\pm\\frac{\\pi}{8}=(8n\\pm1)\\frac{\\pi}{8}$।\n\nব্যাখ্যা: $(8n\\pm1)\\frac{\\pi}{8}$।\n"
 },
 "060f59f5-31bd-414c-ad15-3a94ba59bb47": {
  "mcq_solution_index": 2,
  "answer_text": "$\\frac{5 \\pi}{4}$",
  "explanation_text": "\n$\\cos x=\\sin x$ ⇒ $\\tan x=1$ ⇒ $x=\\frac{\\pi}{4}+n\\pi$।\nঅপশনে আছে $\\frac{5\\pi}{4}$ (n=1) ✓।\n\nব্যাখ্যা: $\\sin\\frac{5\\pi}{4}=\\cos\\frac{5\\pi}{4}=-\\frac{\\sqrt{2}}{2}$।\n"
 },
 "07437a4b-8f4b-4856-9ac3-bfc07b57254a": {
  "mcq_solution_index": 1,
  "answer_text": "$2 n \\pi \\pm \\frac{\\pi}{3}$",
  "explanation_text": "\n$2(\\cos x+\\sec x)=5$ ⇒ $2\\cos x+\\frac{2}{\\cos x}=5$ ⇒ $2\\cos^{2}x-5\\cos x+2=0$\n⇒ $(2\\cos x-1)(\\cos x-2)=0$ ⇒ $\\cos x=\\frac{1}{2}$ ⇒ $x=2n\\pi\\pm\\frac{\\pi}{3}$।\n\nব্যাখ্যা: $\\cos x=\\frac{1}{2}$; $2n\\pi\\pm\\frac{\\pi}{3}$।\n"
 },
 "193f2d93-af47-4568-b279-abb8fed6c0d0": {
  "mcq_solution_index": 2,
  "answer_text": "$(2 \\mathrm{n}+1) \\frac{\\pi}{3}, \\mathrm{n} \\in \\mathbb{Z}$",
  "explanation_text": "\n$\\cos3x=-1$ ⇒ $3x=(2n+1)\\pi$ ⇒ $x=\\frac{(2n+1)\\pi}{3}$।\n\nব্যাখ্যা: $x=(2n+1)\\frac{\\pi}{3}$।\n"
 },
 "1405f8d2-8f58-4e8d-996a-fc0025c5c57b": {
  "mcq_solution_index": -1,
  "explanation_text": "\nউদ্দীপকটি text-এ অনুপস্থিত (শুধু \"হলে নিচের কোনটি সঠিক?\" আছে) — অপশনগুলো থেকে মূল সমীকরণ জানা যায় না:\n$\\sin x=\\sin k$ হলে $x=n\\pi+(-1)^{n}k$ (অপশন ১); $\\cos x=\\cos k$ হলে $x=2n\\pi\\pm k$ (অপশন ৩);\n$\\sin x=\\cos k$ হলে $x=n\\pi+(-1)^{n}(\\frac{\\pi}{2}-k)$ (অপশন ২); $\\cos x=\\sin k$ হলে $x=2n\\pi\\pm(\\frac{\\pi}{2}-k)$ (অপশন ৪)।\nপ্রশ্নের মূল অংশ ছাড়া নির্ধারণ সম্ভব নয়।\n\nব্যাখ্যা: উদ্দীপক অনুপস্থিত — উত্তর নির্ধারণযোগ্য নয়।\n"
 }
}