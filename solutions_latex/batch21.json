{
 "5e1ca6cc-2df2-419f-9f2e-ebf0b963e460": {
  "mcq_solution_index": 1,
  "answer_text": "$\\frac{1}{2}$",
  "explanation_text": "\n$\\cos^{-1}\\left(-\\frac{1}{2}\\right)=\\frac{2\\pi}{3}$, $\\tan^{-1}\\frac{1}{\\sqrt{3}}=\\frac{\\pi}{6}$।\n∴ $\\sin\\left(\\frac{2\\pi}{3}+\\frac{\\pi}{6}\\right)=\\sin\\frac{5\\pi}{6}=\\frac{1}{2}$।\n\nব্যাখ্যা: $\\sin\\frac{5\\pi}{6}=\\frac{1}{2}$।\n"
 },
 "cef9e7e3-90c6-4bb1-9ccd-6b5953fa7d05": {
