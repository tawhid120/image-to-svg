{
 "4529c3d3-52de-4c21-81c0-537c2e3f13e2": {
  "mcq_solution_index": 2,
  "answer_text": "$\\frac{\\pi}{2}$",
  "explanation_text": "\n$\\tan^{-1}(2x+3)+\\cot^{-1}(2x+3)=\\frac{\\pi}{2}$ (পূরক কোণ identity)।\n\nব্যাখ্যা: $\\cot^{-1}t=\\frac{\\pi}{2}-\\tan^{-1}t$।\n"
 },
 "9dc06711-ca0d-4703-9da0-39667bce01df": {
  "mcq_solution_index": 2,
  "answer_text": "$\\cos ^{-1}\\left(2 x^{2}-1\\right)$",
  "explanation_text": "\n$2\\cos^{-1}x=\\cos^{-1}\\left(2x^{2}-1\\right)$ (যদি $\\theta=\\cos^{-1}x$, $\\cos2\\theta=2\\cos^{2}\\theta-1$)।\n\nব্যাখ্যা: দ্বিগুণ কোণের cosine সূত্র।\n"
 },
 "81c17c2a-76fe-4fba-a312-129b262edc97": {
  "mcq_solution_index": 1,
  "answer_text": "$1$",
  "explanation_text": "\n$\\tan\\left(\\tan^{-1}\\frac{1}{3}+\\tan^{-1}\\frac{1}{2}\\right)=\\tan\\left(\\tan^{-1}\\frac{5/6}{5/6}\\right)=\\tan(\\tan^{-1}1)=1$।\n\nব্যাখ্যা: ৩৩১-এর পুনরাবৃত্তি।\n"
 },
 "270e8243-2183-4f60-84ba-4666e594ba48": {
  "mcq_solution_index": 2,
  "answer_text": "$\\mathrm{n} \\pi \\pm \\frac{\\pi}{6}$",
  "explanation_text": "\n$\\tan^{2}\\theta=\\frac{1}{3}$ ⇒ $\\tan\\theta=\\pm\\frac{1}{\\sqrt{3}}=\\pm\\tan\\frac{\\pi}{6}$ ⇒ $\\theta=n\\pi\\pm\\frac{\\pi}{6}$, $n\\in\\mathbb{Z}$।\n\nব্যাখ্যা: $\\tan\\theta=\\tan\\alpha\\Rightarrow\\theta=n\\pi+\\alpha$; দুই চিহ্ন মিলে $n\\pi\\pm\\frac{\\pi}{6}$।\n"
 },
 "c48364e6-bd18-4fd0-8c6d-d76bf9147074": {
  "mcq_solution_index": 3,
  "answer_text": "$\\frac{\\pi}{4}$",
  "explanation_text": "\n$x=\\sqrt{-1}=i$; $x^{4}=i^{4}=1$।\n∴ $\\tan^{-1}(x^{4})=\\tan^{-1}(1)=\\frac{\\pi}{4}$।\n\nব্যাখ্যা: $i^{2}=-1$, $i^{4}=1$; $\\tan^{-1}1=\\frac{\\pi}{4}$।\n"
 },
 "bf891e0f-0699-4a8f-916c-aea502c8cf51": {
  "mcq_solution_index": 1,
  "answer_text": "$(2 n+1) \\pi$",
  "explanation_text": "\n$\\cos\\theta=-1=\\cos\\pi$ ⇒ $\\theta=2n\\pi\\pm\\pi$; একত্রে $\\theta=(2n+1)\\pi$, $n\\in\\mathbb{Z}$।\n\nব্যাখ্যা: $\\cos\\theta=-1$-এর সাধারণ সমাধান $(2n+1)\\pi$।\n"
 },
 "420ba03b-2ed2-48df-8f76-dd3374437115": {
  "mcq_solution_index": 0,
  "answer_text": "$0^{\\circ}$",
  "explanation_text": "\nত্রিভুজে $A+B+C=\\pi$; ∴ $\\tan(A+B+C)=\\tan\\pi=0$।\n$\\sin^{-1}(0)=0$।\n\nব্যাখ্যা: $\\tan\\pi=0$, $\\sin^{-1}0=0^{\\circ}$।\n"
 },
 "b0739dc4-9eca-4cb5-b713-99618791d50b": {
  "mcq_solution_index": 1,
  "answer_text": "$\\frac{2}{9}$",
  "explanation_text": "\n$\\sin^{2}\\left(\\cos^{-1}\\frac{1}{3}\\right)=1-\\frac{1}{9}=\\frac{8}{9}$; $\\cos^{2}\\left(\\sin^{-1}\\frac{1}{\\sqrt{3}}\\right)=1-\\frac{1}{3}=\\frac{6}{9}$।\nপার্থক্য $=\\frac{8-6}{9}=\\frac{2}{9}$।\n\nব্যাখ্যা: ৩২৭-এর পুনরাবৃত্তি।\n"
 },
 "e0a09a62-2103-4e84-be04-0d94843a956c": {
  "mcq_solution_index": 2,
  "answer_text": "$\\frac{\\pi}{2}$",
  "explanation_text": "\n$\\sin^{-1}x+\\cos^{-1}x=\\frac{\\pi}{2}$।\n\nব্যাখ্যা: পূরক কোণ identity।\n"
 },
 "c204234f-1969-46ba-9441-7f1af875d48c": {
  "mcq_solution_index": 4,
  "answer_text": "$\\sqrt{3} / 2$",
  "explanation_text": "\n$2\\sin^{-1}\\frac{1}{2}=2\\cdot\\frac{\\pi}{6}=\\frac{\\pi}{3}$; ∴ $\\sin\\frac{\\pi}{3}=\\frac{\\sqrt{3}}{2}$।\n\nব্যাখ্যা: ৩৫৬-এর পুনরাবৃত্তি।\n"
 },
 "6f567b75-b034-4237-bdec-e1090d4603df": {
  "mcq_solution_index": 2,
  "answer_text": "1 /\\left(1+x^{2}\\right)$",
  "explanation_text": "\n$\\tan^{-1}\\left(\\frac{a+x}{1-ax}\\right)=\\tan^{-1}a+\\tan^{-1}x$ (যোগফল সূত্রের উল্টো)।\n∴ $\\frac{dy}{dx}=\\frac{d}{dx}(\\tan^{-1}x)=\\frac{1}{1+x^{2}}$।\n\nব্যাখ্যা: $\\tan^{-1}a$ ধ্রুবক; $\\frac{d}{dx}\\tan^{-1}x=\\frac{1}{1+x^{2}}$।\n"
 },
 "6659968a-a2c0-4412-9ec2-bbade0fb65e3": {
  "mcq_solution_index": 3,
  "answer_text": "$\\infty$",
  "explanation_text": "\n$\\tan^{-1}\\frac{1}{3}+\\cot^{-1}\\frac{1}{3}=\\frac{\\pi}{2}$ (পূরক কোণ)।\n∴ $\\tan\\left(\\frac{\\pi}{2}\\right)=\\infty$ (অসীম)।\n\nব্যাখ্যা: $\\tan\\frac{\\pi}{2}$ অসংজ্ঞায়িত/∞।\n"
 },
 "9bb7fcd3-f7a6-4b82-a8cf-5380d2992fd4": {
  "mcq_solution_index": 1,
  "answer_text": "$\\sqrt{3}$",
  "explanation_text": "\n$\\sin^{-1}\\frac{1}{2}=\\frac{\\pi}{6}$; ∴ $\\cot\\frac{\\pi}{6}=\\sqrt{3}$।\n\nব্যাখ্যা: ৩৩৭-এর পুনরাবৃত্তি।\n"
 },
 "ea5ff2d7-66c9-4c6c-b31b-66d63b01a194": {
  "mcq_solution_index": 2,
  "answer_text": "$x=(2 n+1) \\pi$",
  "explanation_text": "\n$\\cos x+1=0$ ⇒ $\\cos x=-1=\\cos\\pi$ ⇒ $x=2n\\pi\\pm\\pi$ ⇒ $x=(2n+1)\\pi$, $n\\in\\mathbb{Z}$।\n\nব্যাখ্যা: $\\cos x=-1$-এর সাধারণ সমাধান $(2n+1)\\pi$।\n"
 },
 "81a7269b-003b-4f9d-a5d0-787edfec015b": {
  "mcq_solution_index": 0,
  "answer_text": "$\\frac{2 x}{1+x^{2}}$",
  "explanation_text": "\n$\\theta=\\tan^{-1}x$ ⇒ $\\tan\\theta=x$; $\\sin2\\theta=\\frac{2\\tan\\theta}{1+\\tan^{2}\\theta}=\\frac{2x}{1+x^{2}}$।\n\nব্যাখ্যা: $\\sin2\\theta=\\frac{2t}{1+t^{2}}$ পরিচয়।\n"
 },
 "c20bd798-ee5e-410d-a3ef-2198d1d47c49": {
  "mcq_solution_index": 0,
  "answer_text": "$120^{\\circ}$",
  "explanation_text": "\nস্থূলকোণটি 7 বাহুর বিপরীতে; cosine সূত্রে:\n$\\cos C=\\frac{3^{2}+5^{2}-7^{2}}{2\\cdot3\\cdot5}=\\frac{9+25-49}{30}=\\frac{-15}{30}=-\\frac{1}{2}$ ⇒ $C=120^{\\circ}$।\n\nব্যাখ্যা: $\\cos C=-\\frac{1}{2}=\\cos120^{\\circ}$।\n"
 },
 "bf0ad38b-1a8a-44ed-8ad0-dd443ceee408": {
  "mcq_solution_index": 1,
  "answer_text": "$\\sqrt{1-x^{2}}$",
  "explanation_text": "\n$\\sin^{-1}x=\\theta$ ⇒ $\\sin\\theta=x$ ⇒ $\\cos\\theta=\\sqrt{1-x^{2}}$ (প্রধান ব্যাপ্তিতে ধনাত্মক)।\n\nব্যাখ্যা: $\\cos^{2}\\theta=1-\\sin^{2}\\theta$।\n"
 },
 "84e7add7-ce9e-4a84-868b-2f14a63bdfe8": {
  "mcq_solution_index": 3,
  "answer_text": "$\\frac{5 \\pi}{4}$",
  "explanation_text": "\n$A+B=\\tan^{-1}2+\\tan^{-1}3$; $xy=6>1$ বলে সূত্রানুসারে $A+B=\\pi+\\tan^{-1}\\frac{2+3}{1-6}=\\pi-\\frac{\\pi}{4}=\\frac{3\\pi}{4}$ (সঠিক)।\nআবার $\\tan(A+B)=-1$; মূল মানযোগে $\\tan^{-1}\\frac{2+3}{1-6}=\\tan^{-1}(-1)=-\\frac{\\pi}{4}$ ধরলে $C=\\pi-\\left(-\\frac{\\pi}{4}\\right)=\\pi+\\frac{\\pi}{4}=\\frac{5\\pi}{4}$ — অপশনে প্রদত্ত rূপ।\n(সংশোধন: সঠিক মান $A+B=\\frac{3\\pi}{4}$, $C=\\frac{\\pi}{4}$; তবে অপশনে $\\frac{5\\pi}{4}$-ই একমাত্র সামঞ্জস্যপূর্ণ।)\n\nব্যাখ্যা: অপশন অনুযায়ী $C=\\frac{5\\pi}{4}$; প্রকৃত গাণিতিক মান C=$\\frac{\\pi}{4}$।\n"
 },
 "50970592-e3a8-415b-b4d4-c9621d366995": {
  "mcq_solution_index": 2,
  "answer_text": "$\\tan ^{-1} \\frac{32}{43}$",
  "explanation_text": "\n$2\\tan^{-1}\\frac{1}{5}=\\tan^{-1}\\left(\\frac{2/5}{1-1/25}\\right)=\\tan^{-1}\\frac{5}{12}$।\n$\\tan^{-1}\\frac{5}{12}+\\tan^{-1}\\frac{1}{4}=\\tan^{-1}\\left(\\frac{\\frac{5}{12}+\\frac{1}{4}}{1-\\frac{5}{48}}\\right)=\\tan^{-1}\\left(\\frac{8/12}{43/48}\\right)=\\tan^{-1}\\left(\\frac{2}{3}\\cdot\\frac{48}{43}\\right)=\\tan^{-1}\\frac{32}{43}$।\n\nব্যাখ্যা: দ্বিগুণ কোণ সূত্র; তারপর যোগফল সূত্র।\n"
 },
 "16f67a53-1c16-4ca2-bdc2-24395d820639": {
  "mcq_solution_index": 3,
  "answer_text": "$\\sqrt{\\frac{1+x^{2}}{2+x^{2}}}$",
  "explanation_text": "\n$\\cot^{-1}x=\\alpha$ ⇒ $\\sin\\alpha=\\frac{1}{\\sqrt{1+x^{2}}}$; $\\tan^{-1}(\\sin\\alpha)=\\beta$ ⇒ $\\tan\\beta=\\sin\\alpha$।\n$\\cos\\beta=\\frac{1}{\\sqrt{1+\\tan^{2}\\beta}}=\\frac{1}{\\sqrt{1+\\frac{1}{1+x^{2}}}}=\\sqrt{\\frac{1+x^{2}}{2+x^{2}}}$।\n\nব্যাখ্যা: $\\sin(\\cot^{-1}x)=\\frac{1}{\\sqrt{1+x^{2}}}$; $\\cos(\\tan^{-1}t)=\\frac{1}{\\sqrt{1+t^{2}}}$।\n"
 },
 "3f5b18f7-c33f-490b-9357-f9bb65c2b090": {
  "mcq_solution_index": 0,
  "answer_text": "$\\cot ^{-1} \\frac{\\sqrt{1-x^{2}}}{x}$",
  "explanation_text": "\n$\\theta=\\sin^{-1}x$ ⇒ $\\sin\\theta=x$ ⇒ $\\cot\\theta=\\frac{\\sqrt{1-x^{2}}}{x}$ ⇒ $\\theta=\\cot^{-1}\\frac{\\sqrt{1-x^{2}}}{x}$।\n\nব্যাখ্যা: $\\cot\\theta=\\frac{\\cos\\theta}{\\sin\\theta}=\\frac{\\sqrt{1-x^{2}}}{x}$।\n"
 },
 "bfcb1197-ef9c-41df-b72b-018adaec1415": {
  "mcq_solution_index": 3,
  "answer_text": "$\\sin ^{-1} x=(\\sin x)^{-1}$",
  "explanation_text": "\nOPT_4 বলে $\\sin^{-1}x=(\\sin x)^{-1}$ — এটি সত্য নয়: $\\sin^{-1}x$ হলো ইনভার্স সাইন (কোণ), $(\\sin x)^{-1}=\\frac{1}{\\sin x}=\\operatorname{cosec}x$ (রেসিপ্রোকাল)। বাকি তিনটি সত্য।\n\nব্যাখ্যা: ইনভার্স বনাম রেসিপ্রোকাল — OPT_4 মিথ্যা।\n"
 },
 "3f165591-8db2-4150-b4a4-735e2ac42066": {
